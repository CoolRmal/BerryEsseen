-- All table outputs are signed integers at scale 2^64.
def expEntry (k : Nat) (y : Int) : Bool :=
  k ≤ 32768 && 0 < y && scale*expDenominator ≤ y*horner (k : Int) expCoefficients

def cosEntry (k : Nat) (y : Int) : Bool :=
  18432 ≤ k && k ≤ 25736 &&
  (scale ≤ y || scale*horner ((k : Int)*(k : Int)) cosCoefficients ≤ y*cosDenominator)

def qEntry (upper : Bool) (k : Nat) (y : Int) : Bool :=
  let p : Int := if upper then 3141592653589793239 else 3141592653589793238
  let z := p*(k : Int)
  let d : Int := 4096000000000000000000
  let nc := if upper then upperNumerator else lowerNumerator
  let dc := if upper then upperDenominator else lowerDenominator
  let nl := if upper then upperNumeratorDen else lowerNumeratorDen
  let dl := if upper then upperDenominatorDen else lowerDenominatorDen
  let n := homogeneous (z*z) (d*d) nc
  let den := homogeneous (z*z) (d*d) dc
  let left := y*nl*den
  let right := scale*z*n*dl*d
  k ≤ 2048 && 0 ≤ n && 0 < den &&
  (if upper then right ≤ left else left ≤ right)

structure TableEntry where
  kind : Nat
  index : Nat
  value : Int

def tableEntry (x : TableEntry) : Bool :=
  match x.kind with
  | 0 => expEntry x.index x.value
  | 1 => cosEntry x.index x.value
  | 2 => qEntry false x.index x.value
  | 3 => qEntry true x.index x.value
  | _ => false

structure Primitive where
  kind : Nat
  numerator : Int
  denominator : Nat
  result : Int

-- kind 0: an upper square root with denominator 10^10.
-- kind 1,2: an upper/lower rounded rational with denominator 2^64.
def primitive (x : Primitive) : Bool :=
  0 < x.denominator &&
  match x.kind with
  | 0 => 0 ≤ x.numerator && 0 ≤ x.result &&
      x.numerator*100000000000000000000 ≤ x.result*x.result*(x.denominator : Int)
  | 1 => x.numerator*scale ≤ x.result*(x.denominator : Int)
  | 2 => x.result*(x.denominator : Int) ≤ x.numerator*scale
  | _ => false


end ScalarFullH
