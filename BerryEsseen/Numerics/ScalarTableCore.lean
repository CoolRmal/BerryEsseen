@[expose] public section

/-!
# Exact arithmetic checks for scalar tables at scale 2^64

Copied from the saved scalar certificate core. Semantic soundness is proved
in separate modules. These definitions alone establish no analytic bound.
-/

namespace ScalarFullH

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

def scale : Int := 18446744073709551616

def horner (x : Int) : List Int → Int
  | [] => 0
  | a :: rest => a + x * horner x rest

def homogeneousLoop (x d : Int) : List Int → Int → Int → Int
  | [], out, _ => out
  | a :: rest, out, power => homogeneousLoop x d rest (x*out+a*power) (power*d)

def homogeneous (x d : Int) (coefficients : List Int) : Int :=
  match coefficients.reverse with
  | [] => 0
  | a :: rest => homogeneousLoop x d rest a d

