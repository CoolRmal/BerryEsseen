def factorial : Nat → Nat
  | 0 => 1
  | n+1 => (n+1)*factorial n

def atanPartial (x : Rat) (count : Nat) : Rat :=
  (List.range count).foldl (fun total j ↦
    total+(if j%2 == 0 then 1 else -1)*x^(2*j+1)/((2*j+1 : Nat) : Rat)) 0

def atan5Lo : Rat := atanPartial (1/5) 16
def atan5Error : Rat := (1/5 : Rat)^33/33
def atan239Lo : Rat := atanPartial (1/239) 4
def atan239Error : Rat := (1/239 : Rat)^9/9

theorem piLowerArithmetic : piLower < 16*atan5Lo-4*(atan239Lo+atan239Error) := by decide +kernel

theorem piUpperArithmetic : 16*(atan5Lo+atan5Error)-4*atan239Lo < (3141592653589793239 : Rat)/1000000000000000000 := by decide +kernel

def cosineLowerJoin : Rat := (List.range 16).foldl (fun total j ↦
  total+(if j%2 == 0 then 1 else -1)*(9/2 : Rat)^(2*j)/((factorial (2*j) : Nat) : Rat)) 0

theorem envelopeScaleArithmetic : 1-(81/80 : Rat)/(83/100) ≤ cosineLowerJoin := by decide +kernel


