theorem cosine_sign {s : ℝ} (hs : s ∈ Ioo ((2411 / 6250) : ℝ) (2649 / 6250)) :
    |cos ((2173 / 800) * s)| = 1 * cos ((2173 / 800) * s) := by
  have he := whole80.congr rfl (funext whole_cosine_function)
  have hs' : s ∈ Icc ((center : ℝ) - radius) ((center : ℝ) + radius) := by
    norm_num [center, radius]
    constructor <;> linarith [hs.1, hs.2]
  have hb := he.nonneg_on_panel (f := fun x ↦ cos ((2173 / 800) * x)) (by norm_num [radius]) (by decide +kernel) hs'
  simpa only [one_mul] using abs_of_nonneg hb

theorem square_le_one {s : ℝ} (hs : s ∈ Ioo ((2411 / 6250) : ℝ) (2649 / 6250)) :
    anchorSquare s ≤ 1 := by
  have he := whole91.congr rfl (funext whole_square_function)
